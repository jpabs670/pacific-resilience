{
  "name": "pacific-resilience",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Vendor-neutral, offline-first energy and resilience platform. Monitoring and human decision support only.",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "edge/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "secrets": "node scripts/check-secrets.mjs",
    "check": "npm run lint && npm run secrets",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
