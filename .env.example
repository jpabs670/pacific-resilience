# Copy this file to .env for local development.
# Never place real credentials in this example.
#
# Slice 0 runs entirely on one machine with simulated data. It has no
# credentials, no external services, and no container runtime. Deferred
# services (PostgreSQL, MQTT, Redis, object storage) are recorded in
# docs/architecture/adr/0003-slice-0-storage-and-transport.md, not here:
# a configuration key that nothing reads is indistinguishable from one
# that is broken.

APP_ENV=development

# Ingest and read API
API_PORT=4000

# Local SQLite paths. /data/ is ignored by .gitignore.
SERVER_DB_PATH=./data/server.sqlite
EDGE_OUTBOX_PATH=./data/outbox.sqlite

# Edge gateway. Plain HTTP over loopback is permitted for Slice 0 only;
# TLS and gateway authentication are mandatory before any gateway
# communicates across a network. See docs/security/threat-model.md.
EDGE_INGEST_URL=http://127.0.0.1:4000
EDGE_FLUSH_INTERVAL_MS=5000
EDGE_BATCH_MAX_READINGS=1000
EDGE_OUTBOX_MAX_READINGS=1000000
EDGE_CLOCK_TOLERANCE_MS=2000

# Simulator
SIM_SEED=1
SIM_SCENARIO=normal-day
SIM_INTERVAL_MS=1000
